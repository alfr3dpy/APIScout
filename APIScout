        name: "GitHub Repository Stats",
        category: "dev",
        url: "https://api.github.com/repos/public-apis/public-apis",
        docs: "https://docs.github.com/en/rest",
        desc: {
          en: "Fetch live stars, forks, open issues, and metadata for any public GitHub repo.",
          tr: "Herkese açık herhangi bir GitHub deposunun yıldız, fork ve issue verilerini çeker."
        }
      },
      {
        id: "jsonplaceholder",
        name: "JSONPlaceholder Posts",
        category: "dev",
        url: "https://jsonplaceholder.typicode.com/posts?_limit=5",
        docs: "https://jsonplaceholder.typicode.com/",
        desc: {
          en: "Fake REST API for testing frontend prototypes and pagination.",
          tr: "Arayüz prototiplerini test etmek için sahte REST API verileri."
        }
      },
      {
        id: "dummyjson",
        name: "DummyJSON Products",
        category: "dev",
        url: "https://dummyjson.com/products?limit=4",
        docs: "https://dummyjson.com/docs",
        desc: {
          en: "E-commerce product catalog mock data with prices, ratings, and thumbnails.",
          tr: "Fiyat, puan ve ürün görselleri içeren e-ticaret örnek ürün kataloğu."
        }
      },
      {
        id: "ipify",
        name: "ipify Public IP",
        category: "dev",
        url: "https://api.ipify.org?format=json",
        docs: "https://www.ipify.org/",
        desc: {
          en: "Instant JSON lookup returning your current public IPv4 address.",
          tr: "Mevcut genel IPv4 adresinizi anında JSON formatında döndürür."
        }
      },
      {
        id: "rest-countries",
        name: "REST Countries",
        category: "geo",
        url: "https://restcountries.com/v3.1/name/turkey?fields=name,capital,population,currencies,flags",
        docs: "https://restcountries.com/",
        desc: {
          en: "Detailed country demographics, capitals, currencies, and flag assets.",
          tr: "Ülke nüfusu, başkent, para birimi ve bayrak bilgilerini sunar."
        }
      },
      {
        id: "spaceflight",
        name: "Spaceflight News",
        category: "geo",
        url: "https://api.spaceflightnewsapi.net/v4/articles/?limit=3",
        docs: "https://api.spaceflightnewsapi.net/v4/docs/",
        desc: {
          en: "Latest space exploration and rocket launch news articles.",
          tr: "En güncel uzay araştırmaları ve roket fırlatma haberleri."
        }
      },
      {
        id: "sunrise-sunset",
        name: "Sunrise & Sunset Times",
        category: "geo",
        url: "https://api.sunrise-sunset.org/json?lat=41.0082&lng=28.9784&formatted=0",
        docs: "https://sunrise-sunset.org/api",
        desc: {
          en: "Astronomical sunrise, sunset, and day length data for any coordinates.",
          tr: "Girilen koordinat için gün doğumu, gün batımı ve gün uzunluğu verileri."
        }
      },
      {
        id: "dog-ceo",
        name: "Dog CEO Random Image",
        category: "fun",
        url: "https://dog.ceo/api/breeds/image/random",
        docs: "https://dog.ceo/dog-api/",
        desc: {
          en: "Returns a random dog breed image URL with instant media preview.",
          tr: "Anında görsel önizlemeli rastgele köpek fotoğrafı URL'si döndürür."
        }
      },
      {
        id: "pokeapi",
        name: "PokéAPI Sprite & Stats",
        category: "fun",
        url: "https://pokeapi.co/api/v2/pokemon/pikachu",
        docs: "https://pokeapi.co/docs/v2",
        desc: {
          en: "Comprehensive Pokémon stats, abilities, types, and official sprite URLs.",
          tr: "Pokémon istatistikleri, yetenekleri ve resmi görsel bağlantıları."
        }
      },
      {
        id: "open-library",
        name: "Open Library Search",
        category: "fun",
        url: "https://openlibrary.org/search.json?q=clean+code&limit=3",
        docs: "https://openlibrary.org/developers/api",
        desc: {
          en: "Search millions of book titles, authors, and publication years.",
          tr: "Milyonlarca kitap başlığı, yazar ve basım yılı arasında arama yapın."
        }
      },
      {
        id: "advice-slip",
        name: "Advice Slip JSON",
        category: "fun",
        url: "https://api.adviceslip.com/advice",
        docs: "https://api.adviceslip.com/",
        desc: {
          en: "Lightweight endpoint delivering random life and productivity advice.",
          tr: "Rastgele tavsiye cümleleri sunan hafif ve hızlı JSON uç noktası."
        }
      }
    ];

    let lang = localStorage.getItem("apiscout_lang_v1") || "en";
    let favorites = JSON.parse(localStorage.getItem("apiscout_favs_v1") || "[]");
    let customApis = JSON.parse(localStorage.getItem("apiscout_custom_v1") || "[]");
    let activeCategory = "all";
    let onlyFavorites = false;
    let selectedApiId = DEFAULT_APIS[0].id;
    let codeMode = "fetch";
    let lastRawResponse = null;

    function allApis() {
      return [...customApis, ...DEFAULT_APIS];
    }

    function setLanguage(newLang) {
      lang = newLang;
      localStorage.setItem("apiscout_lang_v1", lang);
      document.documentElement.lang = lang;
      document.getElementById("langEnBtn").classList.toggle("active", lang === "en");
      document.getElementById("langTrBtn").classList.toggle("active", lang === "tr");

      const dict = I18N[lang];
      document.querySelectorAll("[data-i18n]").forEach(el => {
        const key = el.getAttribute("data-i18n");
        if (dict[key]) el.textContent = dict[key];
      });
      document.querySelectorAll("[data-i18n-placeholder]").forEach(el => {
        const key = el.getAttribute("data-i18n-placeholder");
        if (dict[key]) el.placeholder = dict[key];
      });

      document.getElementById("metricAuth").textContent = dict.noKey;
      if (!lastRawResponse) {
        document.getElementById("responseOutput").textContent = dict.readyPrompt;
      }

      renderCategories();
      renderCatalog();
      const current = allApis().find(a => a.id === selectedApiId);
      if (current) {
        document.getElementById("activeDesc").textContent = current.desc[lang] || current.desc.en;
      }
    }

    function renderCategories() {
      const bar = document.getElementById("categoryBar");
      const cats = I18N[lang].categories;
      bar.innerHTML = Object.entries(cats)
        .map(([key, label]) => `
          <button class="cat-pill ${activeCategory === key ? "active" : ""}" onclick="selectCategory('${key}')">
            ${label}
          </button>
        `)
        .join("");
    }

    function selectCategory(cat) {
      activeCategory = cat;
      renderCategories();
      renderCatalog();
    }

    function toggleFavFilter() {
      onlyFavorites = !onlyFavorites;
      document.getElementById("favFilterBtn").style.borderColor = onlyFavorites ? "var(--amber)" : "var(--border)";
      renderCatalog();
    }

    function toggleFavorite(e, id) {
      e.stopPropagation();
      if (favorites.includes(id)) {
        favorites = favorites.filter(f => f !== id);
      } else {
        favorites.push(id);
      }
      localStorage.setItem("apiscout_favs_v1", JSON.stringify(favorites));
      updateFavCount();
      renderCatalog();
    }

    function updateFavCount() {
      document.getElementById("favCount").textContent = favorites.length;
    }

    function renderCatalog() {
      const query = document.getElementById("searchInput").value.trim().toLowerCase();
      const listEl = document.getElementById("catalogList");
      const dict = I18N[lang];

      const filtered = allApis().filter(api => {
        if (onlyFavorites && !favorites.includes(api.id)) return false;
        if (activeCategory !== "all" && api.category !== activeCategory) return false;
        if (!query) return true;
        const descText = (api.desc[lang] || api.desc.en || "").toLowerCase();
        return (
          api.name.toLowerCase().includes(query) ||
          api.url.toLowerCase().includes(query) ||
          descText.includes(query)
        );
      });

      if (filtered.length === 0) {
        listEl.innerHTML = `<div style="color: var(--text-muted); font-size: 0.85rem; padding: 16px;">${dict.emptyCatalog}</div>`;
        return;
      }

      listEl.innerHTML = filtered
        .map(api => {
          const isFav = favorites.includes(api.id);
          const isSelected = api.id === selectedApiId;
          const catLabel = dict.categories[api.category] || api.category;
          const descText = api.desc[lang] || api.desc.en;
          return `
            <div class="api-card ${isSelected ? "selected" : ""}" onclick="selectApi('${api.id}')">
              <div class="api-card-top">
                <div class="api-title">${api.name}</div>
                <button class="fav-btn ${isFav ? "active" : ""}" onclick="toggleFavorite(event, '${api.id}')" title="Favorite">★</button>
              </div>
              <div class="api-desc">${descText}</div>
              <div class="api-badges">
                <span class="badge">${catLabel}</span>
                <span class="badge auth">${dict.noKey}</span>
                <span class="badge cors">${dict.corsYes}</span>
              </div>
            </div>
          `;
        })
        .join("");
    }

    function selectApi(id) {
      const api = allApis().find(a => a.id === id);
      if (!api) return;
      selectedApiId = id;
      lastRawResponse = null;

      document.getElementById("activeTitle").textContent = api.name;
      document.getElementById("activeDesc").textContent = api.desc[lang] || api.desc.en;
      document.getElementById("endpointInput").value = api.url;
      document.getElementById("docsLink").href = api.docs || api.url;
      document.getElementById("responseOutput").textContent = I18N[lang].readyPrompt;
      document.getElementById("imagePreview").style.display = "none";
      document.getElementById("metricStatus").textContent = "—";
      document.getElementById("metricStatus").className = "";
      document.getElementById("metricLatency").textContent = "—";
      document.getElementById("metricSize").textContent = "—";

      updateCodeSnippets();
      renderCatalog();
    }

    function switchCodeTab(mode) {
      codeMode = mode;
      document.getElementById("tabFetch").classList.toggle("active", mode === "fetch");
      document.getElementById("tabCurl").classList.toggle("active", mode === "curl");
      updateCodeSnippets();
    }

    function updateCodeSnippets() {
      const url = document.getElementById("endpointInput").value.trim();
      const out = document.getElementById("codeOutput");
      if (codeMode === "fetch") {
        out.textContent = `const response = await fetch("${url}");\nif (!response.ok) throw new Error(\`HTTP \${response.status}\`);\nconst data = await response.json();\nconsole.log(data);`;
      } else {
        out.textContent = `curl -X GET "${url}" \\\n  -H "Accept: application/json"`;
      }
    }

    function findImageUrl(obj) {
      if (!obj || typeof obj !== "object") return null;
      for (const val of Object.values(obj)) {
        if (typeof val === "string" && /^https?:\/\/.+\.(jpg|jpeg|png|webp|gif)(\?.*)?$/i.test(val)) {
          return val;
        }
        if (typeof val === "object") {
          const nested = findImageUrl(val);
          if (nested) return nested;
        }
      }
      return null;
    }

    async function sendRequest() {
      const url = document.getElementById("endpointInput").value.trim();
      if (!url) return;

      const btn = document.getElementById("sendBtn");
      const statusEl = document.getElementById("metricStatus");
      const latencyEl = document.getElementById("metricLatency");
      const sizeEl = document.getElementById("metricSize");
      const outputEl = document.getElementById("responseOutput");
      const imgBox = document.getElementById("imagePreview");
      const imgEl = document.getElementById("previewImg");

      btn.disabled = true;
      btn.textContent = I18N[lang].sending;
      imgBox.style.display = "none";

      const start = performance.now();
      try {
        const res = await fetch(url);
        const elapsed = Math.round(performance.now() - start);
        const rawText = await res.text();
        const bytes = new Blob([rawText]).size;

        statusEl.textContent = `${res.status} ${res.statusText || "OK"}`;
        statusEl.className = res.ok ? "status-ok" : "status-err";
        latencyEl.textContent = `${elapsed} ms`;
        sizeEl.textContent = bytes > 1024 ? `${(bytes / 1024).toFixed(1)} KB` : `${bytes} B`;

        try {
          const parsed = JSON.parse(rawText);
          lastRawResponse = parsed;
          outputEl.textContent = JSON.stringify(parsed, null, 2);

          const mediaUrl = findImageUrl(parsed);
          if (mediaUrl) {
            imgEl.src = mediaUrl;
            imgBox.style.display = "flex";
          }
        } catch {
          lastRawResponse = null;
          outputEl.textContent = rawText;
        }
      } catch (err) {
        const elapsed = Math.round(performance.now() - start);
        statusEl.textContent = "CORS / Network Error";
        statusEl.className = "status-err";
        latencyEl.textContent = `${elapsed} ms`;
        sizeEl.textContent = "0 B";
        outputEl.textContent = JSON.stringify(
          {
            error: err.message,
            hint:
              lang === "tr"
                ? "Bu uç nokta tarayıcı CORS politikasını engelliyor olabilir veya URL hatalı."
                : "This endpoint may block browser CORS requests or the URL is unreachable."
          },
          null,
          2
        );
      } finally {
        btn.disabled = false;
        btn.textContent = I18N[lang].sendRequest;
      }
    }

    function formatJson() {
      if (lastRawResponse) {
        document.getElementById("responseOutput").textContent = JSON.stringify(lastRawResponse, null, 2);
      }
    }

    function copyText(elementId) {
      const text = document.getElementById(elementId).textContent;
      navigator.clipboard.writeText(text).then(() => {
        showToast(I18N[lang].copiedToast);
      });
    }

    function showToast(msg) {
      const t = document.getElementById("toast");
      t.textContent = msg;
      t.classList.add("show");
      setTimeout(() => t.classList.remove("show"), 2200);
    }

    function openModal() {
      document.getElementById("customModal").classList.add("open");
    }

    function closeModal() {
      document.getElementById("customModal").classList.remove("open");
    }

    function saveCustomApi() {
      const name = document.getElementById("customName").value.trim();
      const category = document.getElementById("customCategory").value;
      const url = document.getElementById("customUrl").value.trim();
      const desc = document.getElementById("customDesc").value.trim() || "Custom GET endpoint.";

      if (!name || !url.startsWith("http")) {
        showToast(I18N[lang].invalidForm);
        return;
      }

      const newApi = {
        id: "custom-" + Date.now(),
        name,
        category,
        url,
        docs: url,
        desc: { en: desc, tr: desc }
      };

      customApis.unshift(newApi);
      localStorage.setItem("apiscout_custom_v1", JSON.stringify(customApis));

      document.getElementById("customName").value = "";
      document.getElementById("customUrl").value = "";
      document.getElementById("customDesc").value = "";
      closeModal();
      selectApi(newApi.id);
      showToast(I18N[lang].savedToast);
    }

    // Boot
    updateFavCount();
    setLanguage(lang);
    selectApi(DEFAULT_APIS[0].id);
  </script>
</body>
</html>
