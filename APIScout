<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>APIScout — Free Public API Explorer &amp; Live Sandbox</title>
  <style>
    :root {
      --bg-body: #090d16;
      --bg-panel: #111827;
      --bg-card: #161f33;
      --bg-input: #0b1120;
      --border: #1e293b;
      --border-hover: #38bdf8;
      --text-main: #f1f5f9;
      --text-muted: #94a3b8;
      --accent: #38bdf8;
      --accent-glow: rgba(56, 189, 248, 0.18);
      --green: #10b981;
      --amber: #f59e0b;
      --red: #ef4444;
      --purple: #a855f7;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
      --font-mono: "JetBrains Mono", "Fira Code", Consolas, monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-body);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.5;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Header */
    header {
      background: rgba(17, 24, 39, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 14px 24px;
      position: sticky;
      top: 0;
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .brand-logo {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: linear-gradient(135deg, #0284c7, #6366f1);
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 16px;
      color: #fff;
      box-shadow: 0 0 20px var(--accent-glow);
    }

    .brand h1 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .brand p {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .lang-switch {
      display: inline-flex;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2px;
    }

    .lang-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 5px 10px;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .lang-btn.active {
      background: var(--accent);
      color: #090d16;
    }

    .btn {
      background: var(--bg-card);
      color: var(--text-main);
      border: 1px solid var(--border);
      padding: 8px 14px;
      border-radius: 8px;
      font-size: 0.83rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
    }

    .btn:hover {
      border-color: var(--border-hover);
      background: #1e293b;
    }

    .btn-primary {
      background: linear-gradient(135deg, #0284c7, #2563eb);
      border: none;
      color: #fff;
    }

    .btn-primary:hover {
      filter: brightness(1.1);
    }

    /* Filter Bar */
    .toolbar {
      padding: 14px 24px;
      background: var(--bg-panel);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .search-box {
      position: relative;
      flex: 1;
      min-width: 240px;
      max-width: 380px;
    }

    .search-box input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 9px 14px 9px 36px;
      border-radius: 8px;
      font-size: 0.85rem;
      outline: none;
    }

    .search-box input:focus {
      border-color: var(--accent);
    }

    .search-box span {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    .categories {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .cat-pill {
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-muted);
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .cat-pill.active, .cat-pill:hover {
      background: var(--accent-glow);
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Main Workspace */
    .workspace {
      display: grid;
      grid-template-columns: 380px 1fr;
      flex: 1;
      min-height: 0;
    }

    @media (max-width: 960px) {
      .workspace {
        grid-template-columns: 1fr;
      }
    }

    /* Left Catalog */
    .catalog {
      border-right: 1px solid var(--border);
      padding: 16px;
      overflow-y: auto;
      max-height: calc(100vh - 132px);
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    @media (max-width: 960px) {
      .catalog {
        max-height: 420px;
        border-right: none;
        border-bottom: 1px solid var(--border);
      }
    }

    .api-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 13px 14px;
      cursor: pointer;
      transition: all 0.15s ease;
      position: relative;
    }

    .api-card:hover {
      border-color: #475569;
      transform: translateY(-1px);
    }

    .api-card.selected {
      border-color: var(--accent);
      background: rgba(56, 189, 248, 0.08);
      box-shadow: 0 0 0 1px var(--accent);
    }

    .api-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 6px;
    }

    .api-title {
      font-weight: 700;
      font-size: 0.92rem;
      color: #fff;
    }

    .fav-btn {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 1rem;
      line-height: 1;
      padding: 2px;
    }

    .fav-btn.active {
      color: var(--amber);
    }

    .api-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 10px;
    }

    .api-badges {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }

    .badge {
      font-size: 0.7rem;
      padding: 2px 8px;
      border-radius: 5px;
      font-weight: 600;
      background: rgba(148, 163, 184, 0.12);
      color: var(--text-muted);
    }

    .badge.cors { background: rgba(16, 185, 129, 0.14); color: var(--green); }
    .badge.auth { background: rgba(56, 189, 248, 0.14); color: var(--accent); }

    /* Right Sandbox */
    .sandbox {
      padding: 20px 24px;
      overflow-y: auto;
      max-height: calc(100vh - 132px);
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    @media (max-width: 960px) {
      .sandbox { max-height: none; }
    }

    .sandbox-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      flex-wrap: wrap;
    }

    .sandbox-header h2 {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .sandbox-header p {
      font-size: 0.84rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .request-bar {
      display: flex;
      gap: 8px;
      background: var(--bg-panel);
      padding: 10px;
      border-radius: 10px;
      border: 1px solid var(--border);
      flex-wrap: wrap;
    }

    .method-tag {
      background: rgba(16, 185, 129, 0.16);
      color: var(--green);
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: 0.82rem;
      padding: 8px 12px;
      border-radius: 7px;
      display: flex;
      align-items: center;
    }

    .url-input {
      flex: 1;
      min-width: 220px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-main);
      font-family: var(--font-mono);
      font-size: 0.82rem;
      padding: 8px 12px;
      border-radius: 7px;
      outline: none;
    }

    .url-input:focus { border-color: var(--accent); }

    /* Telemetry Strip */
    .telemetry {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .metric {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      padding: 6px 12px;
      border-radius: 7px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .metric strong { color: var(--text-main); font-family: var(--font-mono); }
    .status-ok { color: var(--green) !important; }
    .status-err { color: var(--red) !important; }

    /* Output Grid */
    .output-grid {
      display: grid;
      grid-template-columns: 1.35fr 1fr;
      gap: 16px;
    }

    @media (max-width: 1200px) {
      .output-grid { grid-template-columns: 1fr; }
    }

    .panel-box {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .panel-head {
      padding: 10px 14px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .panel-actions {
      display: flex;
      gap: 6px;
    }

    .mini-btn {
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-main);
      font-size: 0.73rem;
      padding: 4px 9px;
      border-radius: 5px;
      cursor: pointer;
    }

    .mini-btn:hover { border-color: var(--accent); }

    pre {
      padding: 14px;
      font-family: var(--font-mono);
      font-size: 0.79rem;
      color: #e2e8f0;
      overflow: auto;
      max-height: 410px;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .image-preview {
      padding: 14px;
      border-bottom: 1px solid var(--border);
      display: none;
      align-items: center;
      justify-content: center;
      background: #060911;
    }

    .image-preview img {
      max-height: 200px;
      max-width: 100%;
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .code-tabs {
      display: flex;
      gap: 6px;
    }

    .code-tab {
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-muted);
      font-size: 0.75rem;
      padding: 3px 8px;
      border-radius: 5px;
      cursor: pointer;
    }

    .code-tab.active {
      background: var(--bg-card);
      border-color: var(--border);
      color: var(--accent);
    }

    /* Modal */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.72);
      display: none;
      place-items: center;
      z-index: 60;
      padding: 16px;
    }

    .modal-backdrop.open { display: grid; }

    .modal {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 12px;
      width: 100%;
      max-width: 460px;
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .modal h3 { font-size: 1.05rem; }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .form-group label {
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .form-group input, .form-group select {
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-main);
      padding: 8px 10px;
      border-radius: 7px;
      font-size: 0.84rem;
    }

    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 6px;
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: #1e293b;
      border: 1px solid var(--accent);
      color: #fff;
      padding: 10px 16px;
      border-radius: 8px;
      font-size: 0.82rem;
      opacity: 0;
      transform: translateY(10px);
      pointer-events: none;
      transition: all 0.2s ease;
      z-index: 80;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <div class="brand-logo">AS</div>
      <div>
        <h1>APIScout</h1>
        <p data-i18n="subtitle">Free Public API Explorer &amp; Live Browser Sandbox</p>
      </div>
    </div>
    <div class="header-actions">
      <div class="lang-switch" role="group" aria-label="Language Switch">
        <button class="lang-btn active" id="langEnBtn" onclick="setLanguage('en')">EN</button>
        <button class="lang-btn" id="langTrBtn" onclick="setLanguage('tr')">TR</button>
      </div>
      <button class="btn" id="favFilterBtn" onclick="toggleFavFilter()">
        <span>★</span> <span data-i18n="favorites">Favorites</span> (<span id="favCount">0</span>)
      </button>
      <button class="btn btn-primary" onclick="openModal()">
        <span>+</span> <span data-i18n="addCustom">Add Custom API</span>
      </button>
    </div>
  </header>

  <div class="toolbar">
    <div class="search-box">
      <span>⌕</span>
      <input type="text" id="searchInput" data-i18n-placeholder="searchPlaceholder" placeholder="Search APIs, endpoints, or categories..." oninput="renderCatalog()" />
    </div>
    <div class="categories" id="categoryBar"></div>
  </div>

  <main class="workspace">
    <aside class="catalog" id="catalogList"></aside>

    <section class="sandbox">
      <div class="sandbox-header">
        <div>
          <h2 id="activeTitle">Open-Meteo Weather</h2>
          <p id="activeDesc">Real-time weather forecast without an API key.</p>
        </div>
        <a id="docsLink" href="https://open-meteo.com/" target="_blank" rel="noopener" class="btn" data-i18n="officialDocs">Official Docs ↗</a>
      </div>

      <div class="request-bar">
        <span class="method-tag">GET</span>
        <input type="text" id="endpointInput" class="url-input" oninput="updateCodeSnippets()" />
        <button class="btn btn-primary" id="sendBtn" onclick="sendRequest()" data-i18n="sendRequest">Send Request</button>
      </div>

      <div class="telemetry">
        <div class="metric"><span data-i18n="statusLabel">Status:</span> <strong id="metricStatus">—</strong></div>
        <div class="metric"><span data-i18n="latencyLabel">Latency:</span> <strong id="metricLatency">—</strong></div>
        <div class="metric"><span data-i18n="sizeLabel">Size:</span> <strong id="metricSize">—</strong></div>
        <div class="metric"><span data-i18n="authLabel">Auth:</span> <strong id="metricAuth">No Key</strong></div>
      </div>

      <div class="output-grid">
        <div class="panel-box">
          <div class="panel-head">
            <span data-i18n="liveResponse">LIVE JSON RESPONSE</span>
            <div class="panel-actions">
              <button class="mini-btn" onclick="formatJson()" data-i18n="formatBtn">Format</button>
              <button class="mini-btn" onclick="copyText('responseOutput')" data-i18n="copyBtn">Copy</button>
            </div>
          </div>
          <div class="image-preview" id="imagePreview">
            <img id="previewImg" src="" alt="API Media Preview" />
          </div>
          <pre id="responseOutput">// Click "Send Request" to inspect live API output...</pre>
        </div>

        <div class="panel-box">
          <div class="panel-head">
            <div class="code-tabs">
              <button class="code-tab active" id="tabFetch" onclick="switchCodeTab('fetch')">JavaScript fetch()</button>
              <button class="code-tab" id="tabCurl" onclick="switchCodeTab('curl')">cURL</button>
            </div>
            <button class="mini-btn" onclick="copyText('codeOutput')" data-i18n="copyBtn">Copy</button>
          </div>
          <pre id="codeOutput"></pre>
        </div>
      </div>
    </section>
  </main>

  <!-- Add Custom API Modal -->
  <div class="modal-backdrop" id="customModal">
    <div class="modal">
      <h3 data-i18n="modalTitle">Add Custom Public API</h3>
      <div class="form-group">
        <label data-i18n="fieldName">API Name</label>
        <input type="text" id="customName" placeholder="e.g., My Custom Endpoint" />
      </div>
      <div class="form-group">
        <label data-i18n="fieldCategory">Category</label>
        <select id="customCategory">
          <option value="dev">Developer Tools</option>
          <option value="finance">Finance &amp; Crypto</option>
          <option value="weather">Weather</option>
          <option value="geo">Geo &amp; Space</option>
          <option value="fun">Media &amp; Fun</option>
        </select>
      </div>
      <div class="form-group">
        <label data-i18n="fieldUrl">GET Endpoint URL</label>
        <input type="url" id="customUrl" placeholder="https://api.example.com/v1/data" />
      </div>
      <div class="form-group">
        <label data-i18n="fieldDesc">Short Description</label>
        <input type="text" id="customDesc" placeholder="Returns JSON items..." />
      </div>
      <div class="modal-footer">
        <button class="btn" onclick="closeModal()" data-i18n="cancelBtn">Cancel</button>
        <button class="btn btn-primary" onclick="saveCustomApi()" data-i18n="saveBtn">Save API</button>
      </div>
    </div>
  </div>

  <div class="toast" id="toast"></div>

